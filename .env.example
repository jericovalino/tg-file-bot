# ─── Telegram ──────────────────────────────────────────────────────────────────
# From @BotFather → /newbot. Server-only. NEVER prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=123456789:AA...
# Bot username without @
TELEGRAM_BOT_USERNAME=my_files_bot
# Random string (16-256 chars, A-Z a-z 0-9 _ -). Telegram echoes it in a header on every webhook call.
# Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Optional: short name of a Direct Link Mini App created with /newapp (t.me/<bot>/<short_name>).
# Leave empty to use the bot's Main Mini App link (t.me/<bot>?startapp=...), configured in BotFather → Configure Mini App.
TELEGRAM_MINI_APP_SHORT_NAME=
# Optional but recommended: a private channel (or group) where the bot is admin. Uploaded files are posted there.
# Leave empty to post uploaded files silently into the group itself.
TELEGRAM_STORAGE_CHAT_ID=
# Optional: self-hosted Bot API server (https://github.com/tdlib/telegram-bot-api) lifts limits to 2000 MB upload / unlimited download.
TELEGRAM_API_ROOT=https://api.telegram.org
# Set to true only when the local Bot API server runs with --local
TELEGRAM_LOCAL_MODE=false

# ─── Limits ───────────────────────────────────────────────────────────────────
# Hosted Bot API: uploads max 50 MB (multipart) and getFile downloads max 20 MB.
# Default 20 MB so every uploaded file can also be downloaded in the browser. Raise to 52428800 (50 MB) if you
# accept that 20–50 MB files are only retrievable via "Send to me in Telegram".
# On Vercel, serverless request bodies are capped at ~4.5 MB: set 4500000 there (larger files use "Upload via Telegram").
MAX_UPLOAD_BYTES=20971520
# 0 = unlimited (only meaningful with a local Bot API server)
MAX_DOWNLOAD_BYTES=20971520
# Comma-separated extensions to reject, e.g. exe,bat,cmd,scr
BLOCKED_FILE_EXTENSIONS=

# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Runtime connection (pooled is fine, e.g. Supabase "Transaction" pooler on port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tg_files
# Direct connection used for migrations (Supabase: port 5432 "Session"/direct). Optional for local dev.
DIRECT_URL=

# ─── Sessions ─────────────────────────────────────────────────────────────────
# >= 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
# Reject Mini App initData older than this (seconds)
INIT_DATA_MAX_AGE_SECONDS=86400
# How long a verified group membership is cached before re-asking Telegram
MEMBERSHIP_CACHE_SECONDS=300

# ─── App ──────────────────────────────────────────────────────────────────────
# Public HTTPS URL of this deployment (Telegram requires HTTPS for Mini Apps and webhooks)
NEXT_PUBLIC_APP_URL=https://files.example.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=my_files_bot
